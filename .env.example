# Supabase Auth (OTP / magic link). Leave placeholders to use the local stub session.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nest API (Épica 1 accept on main; consent-versions / patient-profile when Épica 2 merges)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional clinic name when the invite deep link does not include ?clinica=
NEXT_PUBLIC_DEFAULT_CLINIC_NAME=tu clínica
